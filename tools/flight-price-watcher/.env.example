# ── Amadeus Self-Service API (free): https://developers.amadeus.com ──────────
# Create an app, copy the API Key / API Secret.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (free sandbox, cached-ish prices) or "production" (real prices, free quota too)
AMADEUS_ENV=test

# ── Telegram bot ──────────────────────────────────────────────────────────────
# 1. In Telegram, message @BotFather → /newbot → copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trip ──────────────────────────────────────────────────────────────────────
ORIGIN=LIS
DESTINATION=CAI
DEPARTURE_DATE=2027-03-01
RETURN_DATE=2027-03-09
ADULTS=2
CURRENCY=EUR

# ── Alert rule ────────────────────────────────────────────────────────────────
THRESHOLD_EUR=200
# "per_person" = alert when the price per traveller is below 200€ (default)
# "total" = alert when the combined price for both travellers is below 200€
THRESHOLD_SCOPE=per_person

# ── Scheduling (only used with --loop) ───────────────────────────────────────
INTERVAL_HOURS=6
