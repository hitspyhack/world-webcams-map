# ── SerpApi (Google Flights prices): https://serpapi.com ─────────────────────
# Free sign-up, no credit card — 250 searches/month (4 checks/day ≈ 124/month).
# Copy the API key from your dashboard.
SERPAPI_KEY=

# ── Telegram bot ──────────────────────────────────────────────────────────────
# 1. In Telegram, message @BotFather → /newbot → copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Trip ──────────────────────────────────────────────────────────────────────
ORIGIN=LIS
DESTINATION=CAI
DEPARTURE_DATE=2027-03-01
RETURN_DATE=2027-03-09
ADULTS=2
CURRENCY=EUR

# ── Alert rule ────────────────────────────────────────────────────────────────
THRESHOLD_EUR=250
# "per_person" = alert when the price per traveller is below 250€ (default)
# "total" = alert when the combined price for both travellers is below 250€
THRESHOLD_SCOPE=per_person

# ── Daily heartbeat summary ───────────────────────────────────────────────────
# One Telegram message per day with the current cheapest price, even when it's
# above the threshold — so you know the watcher is alive. Set to false to disable.
DAILY_SUMMARY=true
# The summary is sent by the first check at/after this UTC hour each day.
SUMMARY_AFTER_HOUR_UTC=6

# ── Scheduling (only used with --loop) ───────────────────────────────────────
INTERVAL_HOURS=6
