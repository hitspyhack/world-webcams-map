# ─────────────────────────────────────────────────────────────────────────────
# World Webcams Map — environment variables
# Copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored; never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Windy Webcams API v3
# Get a free key at: https://api.windy.com/keys
# Free tier: 50 webcams per request, image tokens valid ~10 min
WINDY_WEBCAMS_API_KEY=your_windy_webcams_api_key_here

# Apify token (for SkylineWebcams scraper actor)
# Get one at: https://console.apify.com/account/integrations
# Actor used: conversational_kermis~visionsync-skylinewebcams
APIFY_TOKEN=your_apify_token_here
