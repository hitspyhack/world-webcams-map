# Optional: Windy Webcams API v3 key (https://api.windy.com/keys).
# Leave empty to use the other public and curated sources without an API key.
# Copy this file to .env.local. Never commit real credentials.
WINDY_WEBCAMS_API_KEY=

# Optional PUBLIC browser key for Google Maps Embed API.
# Restrict it to Maps Embed API and your deployed HTTP referrers in Google Cloud.
# It is intentionally sent to the browser; never use a private server credential.
# External Google Maps, Earth and Street View links work without it.
GOOGLE_MAPS_EMBED_BROWSER_KEY=
